# InvestHub API — copie para investhub-api/.env:
#   cp .env.example investhub-api/.env
#
# Conteúdo canônico: investhub-api/.env.example

# --- PostgreSQL (Docker Compose) ---
POSTGRES_USER=gerenciador_app
POSTGRES_PASSWORD=gerenciador_dev
POSTGRES_DB=gerenciador_investimentos
POSTGRES_HOST_PORT=5433

# --- Spring Boot (JDBC) ---
INVESTHUB_DB_HOST=localhost
INVESTHUB_DB_PORT=5433
INVESTHUB_DB_NAME=gerenciador_investimentos
INVESTHUB_DB_USERNAME=gerenciador_app
INVESTHUB_DB_PASSWORD=gerenciador_dev

# --- JWT (HS256, mínimo 32 caracteres) ---
INVESTHUB_JWT_SECRET=change-me-use-at-least-32-characters-local
